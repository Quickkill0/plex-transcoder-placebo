#!/usr/bin/with-contenv bash
# Installs the placebo transcoder wrapper over Plex's binary.
set -eu

PLEX_DIR="${PLEX_MEDIA_SERVER_HOME:-/usr/lib/plexmediaserver}"
TRANSCODER="$PLEX_DIR/Plex Transcoder"
CHAINED="$PLEX_DIR/Plex Transcoder.preplacebo"

if [ ! -f "$TRANSCODER" ]; then
    echo "[plex-placebo] $TRANSCODER not found, skipping"
    exit 0
fi

# Skip only if BOTH: the live file is a script (someone's wrapper), and we already have a
# chain target. Each condition alone is wrong:
#
#   script alone      -> on a fresh boot where a peer mod (vaapi-amdgpu wraps this same
#                        path) installed first, we'd see its wrapper and never install.
#   $CHAINED alone    -> after Plex updates in place we'd skip the fresh stock binary and
#                        sit inert.
#
# Together they mean "we have already inserted ourselves into this chain". Getting it wrong
# in the other direction is destructive: moving a wrapper over a $CHAINED that holds the
# real binary loses it, and leaves the wrappers exec'ing each other forever.
magic=$(head -c2 "$TRANSCODER" 2>/dev/null || true)
if [ "$magic" = '#!' ] && [ -f "$CHAINED" ]; then
    echo "[plex-placebo] already in the chain, nothing to do"
    exit 0
fi

# Chain to whatever is currently here rather than assuming it's the stock binary: the
# vaapi-amdgpu mod also wraps the transcoder, and clobbering its wrapper would drop the
# libva stack our own encoding depends on. Works in either mod order.
mv -f "$TRANSCODER" "$CHAINED"
install -m755 /plex-placebo/bin/wrapper.sh "$TRANSCODER"

# libplacebo compiles Vulkan shaders at runtime and caches them here. Non-fatal: a missing
# cache costs a shader recompile per start, which is not worth failing the install over.
mkdir -p /config/cache/placebo 2>/dev/null || true
chown abc:abc /config/cache/placebo 2>/dev/null || true

echo "[plex-placebo] installed (Plex source $(cat /plex-placebo/PLEX_SOURCE_SHA 2>/dev/null | cut -c1-7))"
